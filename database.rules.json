            ".write": "auth != null && (((auth.token.tenantId === $tenantId && (!root.child('users').child(auth.uid).exists() || !root.child('users').child(auth.uid).hasChild('tenantId') || root.child('users').child(auth.uid).child('tenantId').val() === $tenantId)) && (auth.token.role === 'admin' || auth.token.role === 'operator')) || (auth.token.tenantId == null && root.child('users').child(auth.uid).child('tenantId').val() === $tenantId && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'operator')))",
            ".validate": "newData.hasChildren(['id', 'name', 'salePriceCents']) && (!newData.hasChild('salePriceCents') || newData.child('salePriceCents').isNumber()) && (!newData.hasChild('version') || newData.child('version').isNumber())"
          }
        },

        "inventory": {
          ".indexOn": ["productId", "type", "date"],
          "$movementId": {
            ".read": "auth != null && ((auth.token.tenantId === $tenantId && (!root.child('users').child(auth.uid).exists() || !root.child('users').child(auth.uid).hasChild('tenantId') || root.child('users').child(auth.uid).child('tenantId').val() === $tenantId)) || (auth.token.tenantId == null && root.child('users').child(auth.uid).child('tenantId').val() === $tenantId))",
            ".write": "auth != null && (((auth.token.tenantId === $tenantId && (!root.child('users').child(auth.uid).exists() || !root.child('users').child(auth.uid).hasChild('tenantId') || root.child('users').child(auth.uid).child('tenantId').val() === $tenantId)) && (auth.token.role === 'admin' || auth.token.role === 'operator')) || (auth.token.tenantId == null && root.child('users').child(auth.uid).child('tenantId').val() === $tenantId && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'operator'))) && !data.exists() && newData.exists()",
