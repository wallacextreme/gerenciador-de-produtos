            ".write": "auth != null && (((auth.token.tenantId === $tenantId && (!root.child('users').child(auth.uid).exists() || !root.child('users').child(auth.uid).hasChild('tenantId') || root.child('users').child(auth.uid).child('tenantId').val() === $tenantId)) && auth.token.role === 'admin') || (auth.token.tenantId == null && root.child('users').child(auth.uid).child('tenantId').val() === $tenantId && root.child('users').child(auth.uid).child('role').val() === 'admin'))"
