# ==============================================================================
# GestãoPro — Exemplo de Configuração de Variáveis de Ambiente
# ==============================================================================
# ATENÇÃO: Nunca comite chaves privadas, service accounts ou tokens reais neste arquivo.
# Copie este arquivo para .env.local para desenvolvimento local caso necessário.

# Modo Demonstração Pública (GitHub Pages / Portfólio)
# Quando 'true', inicializa o sistema com dataset sintético e utiliza o MockCloudProvider
VITE_PUBLIC_DEMO=true

# Hospedagem em Subdiretório do GitHub Pages (injetado automaticamente pelo GitHub Actions)
# GITHUB_PAGES=true

# Configuração Opcional de Nuvem para Ambiente de Desenvolvimento (Firebase REST)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_APP_ID=
