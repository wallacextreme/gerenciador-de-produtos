{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GestãoPro",
  "version": "1.13.0",
  "identifier": "com.gestaopro.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GestãoPro — Gestão Comercial e Estoque",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "GestãoPro",
    "copyright": "Copyright © 2026 GestãoPro",
    "shortDescription": "Sistema de Gestão Comercial e Estoque",
    "longDescription": "GestãoPro — Sistema completo de gestão comercial, catálogo de produtos, controle de estoque, frente de caixa (PDV), compras, relatórios e análises."
  }
}
