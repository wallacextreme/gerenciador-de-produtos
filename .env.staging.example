# ==============================================================================
# GestãoPro — Configuração de Homologação / Staging (PHASE 09)
# ==============================================================================
# AVISO DE SEGURANÇA:
# 1. NUNCA utilize dados de produção ou projetos de produção neste ambiente.
# 2. NUNCA insira chaves privadas, service accounts ou senhas reais neste arquivo.
# 3. Para testar localmente, copie este arquivo para .env.local e configure
#    os valores do projeto de staging ou dos Firebase Emulators.
# 4. O arquivo .env.local NUNCA deve ser commitado no Git (já ignorado no .gitignore).

# Projeto Firebase de Homologação (Obrigatório ser projeto de staging/teste)
VITE_FIREBASE_PROJECT_ID=gerenciador-produtos-staging

# Configurações Públicas do Firebase Web SDK (Staging)
VITE_FIREBASE_API_KEY=AIzaSy_STAGING_KEY_PLACEHOLDER
VITE_FIREBASE_AUTH_DOMAIN=gerenciador-produtos-staging.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://gerenciador-produtos-staging-default-rtdb.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=gerenciador-produtos-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789000
VITE_FIREBASE_APP_ID=1:123456789000:web:abcdef1234567890

# Configurações do Firebase Emulator Suite (descomente para testes locais sem rede externa)
# VITE_FIREBASE_EMULATOR_HOST=localhost:9000
# VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# VITE_FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Identificador do Tenant de Testes
VITE_STAGING_TENANT_ID=tenant-staging

# ==============================================================================
# Provedor Remoto de Imagens de Produtos (PHASE 14.1)
# Opções: 'firebase' (padrão com Firebase Storage) ou 'supabase' (Supabase Free Tier)
# AVISO: Utilize apenas chaves públicas/anon no frontend. NUNCA utilize service_role!
# ==============================================================================
# VITE_IMAGE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# VITE_SUPABASE_STORAGE_BUCKET=product-images
